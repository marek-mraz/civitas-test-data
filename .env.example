# Copy to .env (or set these in Dokploy -> Environment).
#
# The passwords are REQUIRED — the stack refuses to start without them.
# These services are reachable from the internet: use long, random,
# unique passwords, e.g.:  openssl rand -base64 24

# PostgreSQL (master data source)
POSTGRES_DB=smartmeter
POSTGRES_USER=civitas
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Mosquitto (measurement data source) — TLS only, plaintext is not published
MQTT_USER=civitas
MQTT_PASSWORD=
MQTT_TLS_PORT=8883

# Hostname clients use to reach the services (goes into the TLS certificate)
PUBLIC_HOSTNAME=localhost

# Let's Encrypt for the MQTT listener (needed by clients that VERIFY the
# server cert and can't be told otherwise, e.g. Loxone Miniserver).
# Leave empty to stay on the auto-generated self-signed cert.
# Requires PUBLIC_HOSTNAME to be a real DNS name in your Route 53 zone;
# see README "Let's Encrypt for MQTT" for the IAM policy.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LETSENCRYPT_EMAIL=mrazbb@gmail.com

# Simulator
MQTT_BASE_TOPIC=taf10/sensors
PUBLISH_INTERVAL_SECONDS=15
# Set to false once a real Loxone Miniserver publishes to loxone/sensors —
# stops the simulated temperature stream, smart meters keep running.
SIMULATE_TEMPERATURE=true
